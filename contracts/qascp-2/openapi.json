{
  "openapi": "3.1.0",
  "info": {
    "title": "QASCP 2.0 first-slice design contract",
    "version": "0.1.0",
    "description": "P1 proposed contract. No running API is delivered."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "oidcBearer": []
    }
  ],
  "paths": {
    "/observations": {
      "parameters": [
        {
          "$ref": "#/components/parameters/TenantSelector"
        }
      ],
      "post": {
        "operationId": "ingestObservation",
        "description": "Bound connector and observations:write required. Content-Type is application/json with UTF-8 encoding and a maximum 1 MiB entity body. Tenant selector and connector registration must agree. The trusted intake adapter computes SHA-256 over the exact received entity-body octets after HTTP content/transfer decoding and before charset decoding, JSON parsing or normalization; callers do not supply this replay digest.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./observation.schema.json"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "New logical observation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "200": {
            "description": "Identical replay; previous observation ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "400": {
            "description": "Invalid selector or query",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Quota exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Required service or audit unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Source key has a different digest",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds 1 MiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid observation schema",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/graph/nodes/{node_id}/neighbors": {
      "parameters": [
        {
          "$ref": "#/components/parameters/TenantSelector"
        }
      ],
      "get": {
        "operationId": "getNodeNeighbors",
        "description": "Requires graph:read and resource authorization at every expansion. Cursor binds tenant, subject authorization version and query.",
        "parameters": [
          {
            "name": "node_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "depth",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2,
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 100
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized bounded neighborhood",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Neighborhood"
                }
              }
            }
          },
          "400": {
            "description": "Invalid selector or query",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Quota exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Required service or audit unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Resource absent or inaccessible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "oidcBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Validate against configured OIDC issuer; enforce MFA policy and operation permissions server-side."
      }
    },
    "parameters": {
      "TenantSelector": {
        "name": "X-Tenant-ID",
        "in": "header",
        "required": true,
        "description": "Selector validated against trusted active membership or connector binding.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "correlation_id"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "correlation_id": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "Receipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "observation_id",
          "tenant_id",
          "received_at",
          "disposition",
          "received_payload_digest",
          "correlation_id"
        ],
        "properties": {
          "observation_id": {
            "type": "string",
            "format": "uuid"
          },
          "tenant_id": {
            "type": "string",
            "format": "uuid"
          },
          "received_at": {
            "type": "string",
            "format": "date-time"
          },
          "disposition": {
            "enum": [
              "accepted",
              "duplicate"
            ]
          },
          "received_payload_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "Server-computed SHA-256 of the received request entity bytes used for replay comparison."
          },
          "correlation_id": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "Node": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "enum": [
              "asset",
              "identity",
              "finding",
              "event",
              "ai_system",
              "control",
              "evidence",
              "case",
              "risk",
              "assertion"
            ]
          }
        }
      },
      "Edge": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source_id",
          "target_id",
          "relation",
          "confidence",
          "observation_id",
          "valid_from",
          "recorded_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "source_id": {
            "type": "string",
            "format": "uuid"
          },
          "target_id": {
            "type": "string",
            "format": "uuid"
          },
          "relation": {
            "enum": [
              "owns",
              "runs_as",
              "accesses",
              "affects",
              "observed_on",
              "supports",
              "evaluates",
              "depends_on"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "observation_id": {
            "type": "string",
            "format": "uuid"
          },
          "valid_from": {
            "type": "string",
            "format": "date-time"
          },
          "valid_to": {
            "type": "string",
            "format": "date-time"
          },
          "recorded_at": {
            "type": "string",
            "format": "date-time"
          },
          "supersedes": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Neighborhood": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "nodes",
          "edges",
          "as_of",
          "truncated"
        ],
        "properties": {
          "nodes": {
            "type": "array",
            "maxItems": 201,
            "items": {
              "$ref": "#/components/schemas/Node"
            }
          },
          "edges": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "$ref": "#/components/schemas/Edge"
            }
          },
          "as_of": {
            "type": "string",
            "format": "date-time"
          },
          "truncated": {
            "type": "boolean"
          },
          "next_cursor": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "truncated": {
                  "const": true
                }
              },
              "required": [
                "truncated"
              ]
            },
            "then": {
              "required": [
                "next_cursor"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "next_cursor"
                ]
              }
            }
          }
        ]
      }
    }
  }
}
