{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qascp:2:external-observation-request:1.0",
  "title": "QASCP external connector observation request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "connector_id",
    "source_event_id",
    "observed_at",
    "event_type",
    "resources"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "connector_id": {
      "type": "string",
      "format": "uuid"
    },
    "source_event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "event_type": {
      "type": "string",
      "minLength": 2,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_.-]+$"
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "source_id"
        ],
        "properties": {
          "kind": {
            "enum": [
              "asset",
              "identity",
              "finding",
              "ai_system"
            ]
          },
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "corrects_source_event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "original_evidence_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorized_reference",
        "claimed_sha256"
      ],
      "properties": {
        "authorized_reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "claimed_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
