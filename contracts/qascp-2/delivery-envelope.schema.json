{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qascp:2:delivery-envelope:1.0",
  "title": "QASCP retry, dead-letter and replay envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "delivery_id", "delivery_kind", "tenant_id", "event_id",
    "producer_workload_id", "authorization_version", "purpose", "input_version",
    "attempt", "payload_reference", "payload_digest", "correlation_id", "created_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "delivery_id": {"type": "string", "format": "uuid"},
    "delivery_kind": {"enum": ["initial", "retry", "dead_letter", "replay"]},
    "tenant_id": {"type": "string", "format": "uuid"},
    "event_id": {"type": "string", "format": "uuid"},
    "producer_workload_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "authorization_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 128},
    "input_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "attempt": {"type": "integer", "minimum": 1},
    "replay_of_delivery_id": {"type": "string", "format": "uuid"},
    "payload_reference": {"type": "string", "minLength": 1, "maxLength": 2048},
    "payload_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "correlation_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "created_at": {"type": "string", "format": "date-time"},
    "not_before": {"type": "string", "format": "date-time"},
    "reason_code": {"type": "string", "minLength": 1, "maxLength": 128}
  },
  "allOf": [
    {
      "if": {"properties": {"delivery_kind": {"enum": ["retry", "dead_letter", "replay"]}}, "required": ["delivery_kind"]},
      "then": {"required": ["replay_of_delivery_id", "reason_code"]}
    }
  ]
}
