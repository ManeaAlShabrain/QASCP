{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qascp:2:graph:neighborhood-page:0.2",
  "title": "Authorized snapshot-bound graph page",
  "description": "Proposed P1 boundary contract, not a running endpoint.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "0.2"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "root_id": {
      "type": "string",
      "format": "uuid"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 201,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "maxItems": 200,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id",
        "generation_id",
        "knowledge_cutoff",
        "valid_at",
        "expires_at",
        "projection_state"
      ],
      "properties": {
        "snapshot_id": {
          "type": "string",
          "format": "uuid"
        },
        "generation_id": {
          "type": "string",
          "format": "uuid"
        },
        "knowledge_cutoff": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "valid_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "projection_state": {
          "enum": [
            "current",
            "lagging",
            "unknown"
          ]
        }
      }
    },
    "truncated": {
      "type": "boolean"
    },
    "next_cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "\\S"
    }
  },
  "required": [
    "contract_version",
    "tenant_id",
    "root_id",
    "nodes",
    "edges",
    "snapshot",
    "truncated"
  ],
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "enum": [
            "asset",
            "identity",
            "finding",
            "event",
            "ai_system",
            "control",
            "evidence",
            "case",
            "risk",
            "assertion"
          ]
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_id",
        "target_id",
        "relation",
        "confidence",
        "observation_id",
        "valid_from",
        "recorded_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "source_id": {
          "type": "string",
          "format": "uuid"
        },
        "target_id": {
          "type": "string",
          "format": "uuid"
        },
        "relation": {
          "enum": [
            "owns",
            "runs_as",
            "accesses",
            "affects",
            "observed_on",
            "supports",
            "evaluates",
            "depends_on"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "observation_id": {
          "type": "string",
          "format": "uuid"
        },
        "valid_from": {
          "type": "string",
          "format": "date-time"
        },
        "valid_to": {
          "type": "string",
          "format": "date-time"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "supersedes": {
          "type": "string",
          "format": "uuid"
        },
        "qualifier": {
          "enum": [
            "entitlement",
            "observed_use"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "relation": {
                "const": "accesses"
              }
            }
          },
          "then": {
            "required": [
              "qualifier"
            ]
          },
          "else": {
            "not": {
              "required": [
                "qualifier"
              ]
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "truncated": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "next_cursor"
        ]
      },
      "else": {
        "not": {
          "required": [
            "next_cursor"
          ]
        }
      }
    }
  ]
}
