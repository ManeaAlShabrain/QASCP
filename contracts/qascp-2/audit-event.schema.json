{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qascp:2:audit-event:1.0",
  "title": "QASCP tenant audit event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "audit_event_id", "tenant_id", "actor_id", "actor_type",
    "authorization_version", "action", "resource_type", "resource_id", "outcome",
    "occurred_at", "correlation_id"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "audit_event_id": {"type": "string", "format": "uuid"},
    "tenant_id": {"type": "string", "format": "uuid"},
    "actor_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "actor_type": {"enum": ["user", "workload", "connector", "system"]},
    "authorization_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "action": {"type": "string", "minLength": 1, "maxLength": 128},
    "resource_type": {"type": "string", "minLength": 1, "maxLength": 128},
    "resource_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "outcome": {"enum": ["succeeded", "denied", "failed", "indeterminate"]},
    "reason_code": {"type": "string", "minLength": 1, "maxLength": 128},
    "occurred_at": {"type": "string", "format": "date-time"},
    "correlation_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "input_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "payload_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
