{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qascp:2:consumer-receipt:1.0",
  "title": "QASCP tenant consumer receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "receipt_id", "tenant_id", "event_id", "consumer_workload_id",
    "authorization_version", "purpose", "input_version", "outcome", "recorded_at", "correlation_id"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "receipt_id": {"type": "string", "format": "uuid"},
    "tenant_id": {"type": "string", "format": "uuid"},
    "event_id": {"type": "string", "format": "uuid"},
    "consumer_workload_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "authorization_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 128},
    "input_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "outcome": {"enum": ["processed", "duplicate", "quarantined", "failed"]},
    "reason_code": {"type": "string", "minLength": 1, "maxLength": 128},
    "recorded_at": {"type": "string", "format": "date-time"},
    "correlation_id": {"type": "string", "minLength": 1, "maxLength": 128}
  }
}
